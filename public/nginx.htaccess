  location / {
        index  index.php index.html index.htm;
         #???????????????????????????????????????????§Õ????
         if (!-e $request_filename)
         {
            #????????????rewrite??index.php???
            rewrite ^/(.*)$ /index.php?s=$1;
            #???????????????????????subdir???????????¨À?
            #rewrite ^/subdir/(.*)$ /subdir/index.php?s=$1;
         }
    }
    
    location /api/ {
        index  index.php index.html index.htm;
         #???????????????????????????????????????????§Õ????
         if (!-e $request_filename)
         {
            #???????????????????????subdir???????????¨À?
            rewrite ^/api/(.*)$ /api.php?s=$1;
         }
    }